}

USAGE="usage: gcp [-y] [-i] \"<type>[(scope)][!]: <description>\" [--] [path...] (quote the message)
       gcp amend [-y] [-i] [-m \"<message>\"] [--] [path...]
       gcp undo [-y] | status | history [n] [type] | -h | -v
       gcp new <type> <name> | sync | pr [--draft|--merge] | changelog | release | config"

# True if the word is a gitmoji shortcode (:bug:) or starts with a unicode emoji.
# Checked on UTF-8 bytes: U+1Fxxx (F0 9F ..) and symbols U+2190-U+2BFF (E2 86..AF ..).
# Letters like Ü, é or ß are not emoji.
is_emoji() {
    local word="$1"
    [[ "$word" =~ ^:[a-z0-9_+-]+:$ ]] && return 0
    LC_ALL=C grep -qE $'^(\xF0\x9F|\xE2[\x86-\xAF])' <<< "$word"
}

require_repo() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repository."
    GIT_DIR="$(git rev-parse --git-dir)"
    REPO_ROOT="$(git rev-parse --show-toplevel)"
    load_config
}

require_commits() {
    git rev-parse -q --verify HEAD >/dev/null || die "there are no commits yet."
}

require_tools() {
    if [[ "${SKIP_GITLEAKS:-0}" != "1" ]]; then
        command -v gitleaks >/dev/null 2>&1 \
            || die "gitleaks not found. Install it or run with SKIP_GITLEAKS=1."
        gitleaks git --help >/dev/null 2>&1 \
            || die "gitleaks is too old (needs >= 8.19 for 'gitleaks git')."
    fi
}

# Prints the operation in progress (rebase, merge, cherry-pick, revert) or nothing
operation_in_progress() {
    if [[ -d "$GIT_DIR/rebase-merge" || -d "$GIT_DIR/rebase-apply" ]]; then
        echo "rebase"
    elif [[ -f "$GIT_DIR/MERGE_HEAD" ]]; then
        echo "merge"
    elif [[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ]]; then
        echo "cherry-pick"
    elif [[ -f "$GIT_DIR/REVERT_HEAD" ]]; then
        echo "revert"
    fi
}

require_no_operation() {
    local op
    op="$(operation_in_progress)"
    [[ -z "$op" ]] || die "a $op is in progress. Finish or abort it first."
}

# main, master and the configured base_branch take no direct commits
is_protected_branch() {
    [[ "$1" == "main" || "$1" == "master" || ( -n "${CFG[base_branch]}" && "$1" == "${CFG[base_branch]}" ) ]]
}

require_branch() {
    BRANCH="$(git branch --show-current)"
    [[ -n "$BRANCH" ]] || die "detached HEAD, check out a branch first."
    if is_protected_branch "$BRANCH" && [[ "${ALLOW_MAIN:-0}" != "1" ]]; then
        die "refusing to commit directly to $BRANCH. Use a feature or release branch, or run with ALLOW_MAIN=1."
    fi
}

# Upstream remote first, otherwise the only configured remote
require_remote() {
    REMOTE="$(git config --get "branch.$BRANCH.remote" || true)"
    if [[ -z "$REMOTE" ]]; then
        local -a remotes=()
        mapfile -t remotes < <(git remote)
        case ${#remotes[@]} in
            0) die "no remote configured." ;;
            1) REMOTE="${remotes[0]}" ;;
            *) die "multiple remotes and no upstream for $BRANCH. Push once manually: git push -u <remote> $BRANCH" ;;
        esac
    fi
}

require_tty_for_confirm() {
    if [[ "$ASSUME_YES" != "1" ]]; then
        [[ -t 0 ]] || die "no interactive terminal, cannot ask for confirmation. Use -y to skip it."
    fi
}

# confirm "<question>": exits with "Aborted." unless answered y (or -y given)
confirm() {
    if [[ "$ASSUME_YES" == "1" ]]; then
        echo "Confirmation skipped (-y)."
        return 0
    fi
    local answer
    read -r -p "$1 [y/N] " answer
    if [[ ! "$answer" =~ ^[yY]$ ]]; then
        echo "Aborted."
        exit 0
    fi
}

# True if the commit is on any remote-tracking branch (as of the last fetch)
is_pushed() {
    [[ -n "$(git for-each-ref --count=1 --contains "$1" refs/remotes 2>/dev/null)" ]]
}

is_merge_commit() {
    git rev-parse -q --verify "$1^2" >/dev/null
}

# ---------------------------------------------------------------------------
# Commit message
# ---------------------------------------------------------------------------

# parse_message "<raw message>" [check_scope: 1|0]
# Validates Conventional Commits (and the configured scopes), adds the gitmoji
# and sets CC_TYPE, IS_BREAKING, HEADER, BODY and MESSAGE.
parse_message() {
    local raw raw_header description first_word rest
    raw="$(printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -n "$raw" ]] || die "commit message is empty."

    raw_header="$(printf '%s\n' "$raw" | head -n1)"
    # Body without leading blank lines (re-added as exactly one separator below)
    BODY="$(printf '%s\n' "$raw" | tail -n +2 | sed '/./,$!d')"

    if [[ ! "$raw_header" =~ $CC_REGEX ]]; then
        {
            echo "Error: commit message does not follow Conventional Commits."
            echo "  Got:      $raw_header"
            echo "  Expected: <type>[(scope)][!]: <description>"
            echo "  Types:    ${CC_TYPES//|/, }"
            echo "  Example:  fix(api): handle empty response"
        } >&2
        exit 1
    fi

    CC_TYPE="${BASH_REMATCH[1]}"
    local cc_scope="${BASH_REMATCH[2]}" cc_bang="${BASH_REMATCH[3]}"
    if [[ "${2:-1}" == 1 ]]; then
        local scope_name="${cc_scope#(}"
        check_scope "${scope_name%)}" "$CC_TYPE"
    fi
    description="${BASH_REMATCH[4]}"

    IS_BREAKING=0
    local breaking_re=$'(^|\n)BREAKING[ -]CHANGE: '
    if [[ -n "$cc_bang" ]] || [[ "$BODY" =~ $breaking_re ]]; then
        IS_BREAKING=1
    fi

    # Gitmoji: keep the user's own, otherwise add one based on type
    first_word="${description%% *}"
    if is_emoji "$first_word"; then
        rest="${description#"$first_word"}"
        rest="${rest#"${rest%%[![:space:]]*}"}"
        [[ -n "$rest" ]] || die "description is missing after the gitmoji."
    elif (( IS_BREAKING )); then
        description="$GITMOJI_BREAKING $description"
    else
        description="${GITMOJI[$CC_TYPE]} $description"
    fi

    HEADER="${CC_TYPE}${cc_scope}${cc_bang}: ${description}"
    if [[ -n "$BODY" ]]; then
        # Git needs a blank line between subject and body/footer
        MESSAGE="${HEADER}"$'\n\n'"${BODY}"
    else
        MESSAGE="$HEADER"
    fi

    if (( ${#HEADER} > MAX_HEADER_LENGTH )); then
        die "commit header is ${#HEADER} characters (including the gitmoji), max is ${MAX_HEADER_LENGTH}: $HEADER"
    fi
}

# Sets IS_RELEASE, WILL_TAG, REL_MAJOR, REL_MINOR; dies on forbidden types
check_release_rules() {
    IS_RELEASE=0
    WILL_TAG=0
    REL_MAJOR=""
    REL_MINOR=""
    [[ "$BRANCH" == release/* ]] || return 0

    if [[ ! "$BRANCH" =~ ^release/([0-9]+)\.([0-9]+)$ ]]; then
        die "release branches must be named release/X.Y (e.g. release/1.4), got: $BRANCH"
    fi
    IS_RELEASE=1
    REL_MAJOR="${BASH_REMATCH[1]}"
    REL_MINOR="${BASH_REMATCH[2]}"

    if (( IS_BREAKING )); then
        die "breaking changes are not allowed on $BRANCH. They need a new major release branch."
    fi
    if [[ "$CC_TYPE" == "feat" ]]; then
        die "feat is not allowed on $BRANCH. New features need a new minor release branch."
    fi
    if [[ "$CC_TYPE" == "fix" ]]; then
        WILL_TAG=1
    fi
}

# ---------------------------------------------------------------------------
# Paths and file selection
# ---------------------------------------------------------------------------

set_paths() {
    PATHS=("$@")
    if (( $# )); then
        PATHSPEC=(-- "$@")
    else
        PATHSPEC=()
    fi
}

# Every path must exist, be in the index, or be in HEAD (deleted/renamed away)
validate_paths() {
    local p
    for p in ${PATHS[@]+"${PATHS[@]}"}; do
        if [[ ! -e "$p" ]] && ! git ls-files --error-unmatch -- "$p" >/dev/null 2>&1 \
            && [[ -z "$(git ls-tree --name-only HEAD -- "$p" 2>/dev/null)" ]]; then
            die "path not found and not tracked by git: $p (did you forget to quote the message?)"
        fi
    done
}

has_changes() {
    [[ -n "$(git status --porcelain ${PATHSPEC[@]+"${PATHSPEC[@]}"})" ]]
}

# Sets PATHS/PATHSPEC from a list of changed files the user picks.
select_files() {
    [[ -t 0 && -t 1 ]] || die "-i needs an interactive terminal."

    # Changed files as "XY path" (renames also add the old path)
    local -a status=() files=() old=()
    local entry xy
    while IFS= read -r -d '' entry; do
        xy="${entry:0:2}"
        status+=("$xy")
        files+=("${entry:3}")
        if [[ "$xy" == R* || "$xy" == C* ]]; then
            IFS= read -r -d '' entry
            old+=("$entry")
        else
            old+=("")
        fi
    done < <(git status --porcelain=v1 -z --untracked-files=all)

    (( ${#files[@]} )) || { echo "Nothing to commit."; exit 0; }

    local -a picked=()
    local i
    if [[ "${GCP_NO_FZF:-0}" != "1" ]] && command -v fzf >/dev/null 2>&1; then
        local preview line
        # Diff against HEAD; untracked files (or a repo without commits) as new file.
        # The single quotes are intended: the preview shell expands this, not gcp.
        # shellcheck disable=SC2016
        preview='out="$(git diff --color=always HEAD -- {3} 2>/dev/null)"; '
        # shellcheck disable=SC2016
        preview+='if [ -n "$out" ]; then printf "%s\n" "$out"; '
        preview+='else git diff --color=always --no-index /dev/null {3} 2>/dev/null; [ $? -le 1 ] || echo "(no preview)"; fi'
        while IFS= read -r -d '' line; do
            picked+=("${line%%$'\t'*}")
        done < <(
            for i in "${!files[@]}"; do
                printf '%s\t%s\t%s\0' "$i" "${status[$i]}" "${files[$i]}"
            done | SHELL='sh' fzf --multi --read0 --print0 --delimiter=$'\t' --with-nth=2.. \
                --header='TAB: select   ctrl-a: all   ENTER: confirm   ESC: abort' \
                --bind='ctrl-a:toggle-all' \
                --prompt='Files to commit> ' \
                --preview="$preview" --preview-window='right,60%,wrap' \
            || true
        )
    else
        echo "Changed files:"
        for i in "${!files[@]}"; do
            printf '  %3d) %s %s\n' "$((i + 1))" "${status[$i]}" "${files[$i]}"
        done
        echo
        local answer token from to n
        read -r -p "Select files (e.g. 1 3 5-7, a = all, empty = abort): " answer
        if [[ "$answer" =~ ^[[:space:]]*[aA][[:space:]]*$ ]]; then
            picked=("${!files[@]}")
        else
            for token in ${answer//,/ }; do
                if [[ "$token" =~ ^([0-9]+)-([0-9]+)$ ]]; then
                    from="${BASH_REMATCH[1]}"; to="${BASH_REMATCH[2]}"
                elif [[ "$token" =~ ^[0-9]+$ ]]; then
                    from="$token"; to="$token"
                else
                    die "invalid selection: $token"
                fi
                (( from >= 1 && to <= ${#files[@]} && from <= to )) \
                    || die "selection out of range: $token (1-${#files[@]})"
                for (( n = from; n <= to; n++ )); do
                    picked+=("$((n - 1))")
                done
            done
        fi
    fi

    if (( ${#picked[@]} == 0 )); then
        echo "No files selected. Aborted."
        exit 0
    fi

    # Deduplicate, keep order; renames bring their old path along
    local -A seen=()
    local -a chosen=()
    for i in "${picked[@]}"; do
        [[ -n "${seen[$i]:-}" ]] && continue
        seen[$i]=1
        chosen+=("${files[$i]}")
        if [[ -n "${old[$i]}" ]]; then
            chosen+=("${old[$i]}")
        fi
    done
    set_paths "${chosen[@]}"
}

show_changes() {
    echo "Changes:"
    git --no-pager status --short ${PATHSPEC[@]+"${PATHSPEC[@]}"}
    echo
    git --no-pager diff --stat HEAD ${PATHSPEC[@]+"${PATHSPEC[@]}"} 2>/dev/null || true
    echo
}

# ---------------------------------------------------------------------------
# Staging and checks
# ---------------------------------------------------------------------------

unstage_paths() {
    # Works on normal branches and on a fresh repo without commits.
    # With paths, only those are unstaged, other staged changes are kept.
    if (( ${#PATHS[@]} )); then
        git reset -q -- "${PATHS[@]}" 2>/dev/null \
            || git rm -r -q --cached --ignore-unmatch -- "${PATHS[@]}" >/dev/null 2>&1 || true
    else
        git reset -q 2>/dev/null || git rm -r -q --cached . >/dev/null 2>&1 || true
    fi
}

abort_unstaged() {
    unstage_paths
    echo "Nothing was committed, changes were unstaged." >&2
    exit 1
}

stage_changes() {
    if (( ${#PATHS[@]} )); then
        # Paths that are only in HEAD (deletion already staged) cannot be added,
        # "git commit -- path" picks them up anyway.
        local -a add_paths=()
        local p
        for p in "${PATHS[@]}"; do
            if [[ -e "$p" ]] || git ls-files --error-unmatch -- "$p" >/dev/null 2>&1; then
                add_paths+=("$p")
            fi
        done
        if (( ${#add_paths[@]} )); then
            git add -A -- "${add_paths[@]}"
        fi
    else
        git add -A
    fi
}

# Secret names, secret contents (gitleaks), file size. Unstages and exits on failure.
check_staged() {
    # 1) Suspicious file names (only added/copied/modified/renamed, deletions are fine)
    local suspicious
    suspicious="$(git diff --cached --name-only --diff-filter=ACMR ${PATHSPEC[@]+"${PATHSPEC[@]}"} \
        | grep -E "$SECRET_PATTERN" \
        | grep -Ev "$SECRET_ALLOWED" || true)"
    if [[ -n "$suspicious" ]]; then
        echo "Error: files that look like secrets are staged:" >&2
        echo "$suspicious" >&2
        echo "Add them to .gitignore, or commit manually if this is intended." >&2
        abort_unstaged
    fi

    # 2) Secrets inside file contents
    if [[ "${SKIP_GITLEAKS:-0}" != "1" ]]; then
        if ! gitleaks git --pre-commit --staged --redact --no-banner "$REPO_ROOT"; then
            echo "Error: gitleaks found possible secrets in the staged changes (see above)." >&2
            abort_unstaged
        fi
    fi

    # 3) Files too large for GitHub
    local max_bytes=$((MAX_FILE_MIB * 1024 * 1024)) big="" file size
    while IFS= read -r -d '' file; do
        size="$(git cat-file -s ":$file")"
        if (( size >= max_bytes )); then
            big+="  $file ($((size / 1024 / 1024)) MiB)"$'\n'
        fi
    done < <(git diff --cached --name-only --diff-filter=ACMR -z ${PATHSPEC[@]+"${PATHSPEC[@]}"})
    if [[ -n "$big" ]]; then
        echo "Error: files of ${MAX_FILE_MIB} MiB or more are staged:" >&2
        printf '%s' "$big" >&2
        echo "Use Git LFS or add them to .gitignore." >&2
        abort_unstaged
    fi
}

# ---------------------------------------------------------------------------
# Push
# ---------------------------------------------------------------------------

# Pull --rebase (if there is an upstream) and push. Exits with a clear message on failure.
push_branch() {
    local -a push_cmd
    if git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
        # --autostash: changes outside the committed paths stay untouched
        if ! git pull --rebase --autostash; then
            if [[ -d "$GIT_DIR/rebase-merge" || -d "$GIT_DIR/rebase-apply" ]]; then
                echo "Error: rebase onto $REMOTE failed because of a conflict." >&2
                echo "Your commit is safe. Resolve the conflicts, then run:" >&2
                echo "  git rebase --continue && git push" >&2
                echo "Or undo the pull with:" >&2
                echo "  git rebase --abort" >&2
            else
                echo "Error: could not pull from $REMOTE (network, access or missing branch?)." >&2
                echo "The commit was created locally and is safe. Push later with:" >&2
                echo "  git pull --rebase && git push" >&2
            fi
            exit 1
        fi
        push_cmd=(git push)
    else
        push_cmd=(git push -u "$REMOTE" "$BRANCH")
    fi

    if ! "${push_cmd[@]}"; then
        echo "Error: push to $REMOTE failed." >&2
        echo "The commit was created locally and is safe. Retry with:" >&2
        echo "  ${push_cmd[*]}" >&2
        if (( ${WILL_TAG:-0} )); then
            echo "No release tag was created. Tag manually after pushing." >&2
        fi
        exit 1
    fi
}

create_release_tag() {
    git fetch --tags --quiet "$REMOTE" || die "commit pushed, but could not fetch tags. Tag manually."

    local last tag
    last="$(git tag --list "v${REL_MAJOR}.${REL_MINOR}.*" \
        | sed -E "s/^v${REL_MAJOR}\.${REL_MINOR}\.//" \
        | grep -E '^[0-9]+$' \
        | sort -n \
        | tail -n1 || true)"
    [[ -n "$last" ]] || die "commit pushed, but no valid v${REL_MAJOR}.${REL_MINOR}.N tag found. Tag manually."

    tag="v${REL_MAJOR}.${REL_MINOR}.$((last + 1))"
    if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
        die "commit pushed, but tag $tag already exists. Tag manually."
    fi

    git tag -a "$tag" -m "$tag: $HEADER"
    if ! git push "$REMOTE" "refs/tags/$tag"; then
        echo "Error: commit pushed, but pushing tag $tag failed." >&2
        echo "Retry with: git push $REMOTE refs/tags/$tag" >&2
        exit 1
    fi
    echo "Released $tag"
}

# ---------------------------------------------------------------------------
# gcp "<message>" [path...]
# ---------------------------------------------------------------------------

cmd_commit() {
    local message_arg="$1"
    shift
    [[ "${1:-}" == "--" ]] && shift
    if (( $# )); then
        (( INTERACTIVE )) && die "-i and paths cannot be combined. Use one of them."
        set_paths "$@"
    fi

    require_repo
    parse_message "$message_arg"
    require_tools
    require_no_operation
    validate_paths

    if ! has_changes; then
        if (( ${#PATHS[@]} )); then
            echo "Nothing to commit in the given paths."
        else
            echo "Nothing to commit."
        fi
        exit 0
    fi

    require_branch
    require_remote
    check_release_rules

    # Make sure the release line has a base tag before committing
    if (( WILL_TAG )); then
        git fetch --tags --quiet "$REMOTE" || die "could not fetch tags from $REMOTE."
        if [[ -z "$(git tag --list "v${REL_MAJOR}.${REL_MINOR}.*")" ]]; then
            die "no base tag for $BRANCH. Tag the release first, e.g.: git tag -a v${REL_MAJOR}.${REL_MINOR}.0 -m \"v${REL_MAJOR}.${REL_MINOR}.0\""
        fi
    fi

    require_tty_for_confirm
    # Pick files only now, after all checks that could still refuse the commit
    if (( INTERACTIVE )); then
        select_files
    fi

    echo "Branch:  $BRANCH"
    echo "Remote:  $REMOTE"
    if (( ${#PATHS[@]} )); then
        echo "Paths:   ${PATHS[*]} (other changes are not committed)"
    fi
    echo "Message: $HEADER"
    if [[ -n "$BODY" ]]; then
        printf '%s\n' "$BODY" | sed 's/^/         /'
    fi
    if (( WILL_TAG )); then
        echo "Tag:     next patch on v${REL_MAJOR}.${REL_MINOR}.x (created after push)"
    elif (( IS_RELEASE )); then
        echo "Tag:     none ($CC_TYPE does not trigger a release)"
    fi
    echo
    show_changes
    confirm "Commit and push these changes?"

    stage_changes
    check_staged

    # With paths, "git commit -- path..." commits only those paths, even if
    # other changes are already staged.
    if ! git commit -m "$MESSAGE" ${PATHSPEC[@]+"${PATHSPEC[@]}"}; then
        unstage_paths
        die "commit failed (hook or message rejected). Changes were unstaged, nothing is lost."
    fi

    push_branch
    if (( WILL_TAG )); then
        create_release_tag
    fi
}

# ---------------------------------------------------------------------------
# gcp amend [-m "<message>"] [path...]
# ---------------------------------------------------------------------------

cmd_amend() {
    local new_message=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes)          ASSUME_YES=1; shift ;;
            -i|--interactive)  INTERACTIVE=1; shift ;;
            -m|--message)      [[ $# -ge 2 ]] || die "-m needs a message."
                               new_message="$2"; shift 2 ;;
            --)                shift; break ;;
            -*)                die "unknown option for amend: $1" ;;
            *)                 break ;;
        esac
    done
    if (( $# )); then
        (( INTERACTIVE )) && die "-i and paths cannot be combined. Use one of them."
        set_paths "$@"
    fi

    require_repo
    require_commits
    require_no_operation
    if is_merge_commit HEAD; then
        die "the last commit is a merge commit, gcp amend does not change merges."
    fi
    require_branch
    require_remote

    if is_pushed HEAD; then
        die "the last commit is already pushed. Amending would rewrite shared history.
       Make a new commit instead, or use 'gcp undo' to revert it."
    fi

    local old_header
    old_header="$(git log -1 --format=%s)"
    if [[ -n "$new_message" ]]; then
        parse_message "$new_message"
        check_release_rules
    else
        BRANCH="$(git branch --show-current)"
    fi
    WILL_TAG=0   # tags are only created by a normal gcp commit

    validate_paths
    local include_changes=0
    if has_changes; then
        include_changes=1
    fi
    if (( ! include_changes )) && [[ -z "$new_message" ]]; then
        if (( ${#PATHS[@]} )); then
            echo "Nothing to amend in the given paths."
        else
            echo "Nothing to amend. Change files or pass -m \"<new message>\"."
        fi
        exit 0
    fi
    if (( include_changes )); then
        require_tools
    fi

    require_tty_for_confirm
    if (( INTERACTIVE && include_changes )); then
        select_files
    fi

    echo "Branch:  $BRANCH"
    echo "Amend:   $(git log -1 --format='%h') $old_header (not pushed yet)"
    if [[ -n "$new_message" ]]; then
        echo "Message: $HEADER (new)"
    else
        echo "Message: unchanged"
    fi
    if (( ${#PATHS[@]} )); then
        echo "Paths:   ${PATHS[*]} (other changes are not added)"
    fi
    echo
    if (( include_changes )); then
        show_changes
    else
        echo "Changes: none, only the message is changed"
        echo
    fi
    confirm "Amend the last commit and push?"

    local -a commit_args=(--amend)
    if [[ -n "$new_message" ]]; then
        commit_args+=(-m "$MESSAGE")
    else
        commit_args+=(--no-edit)
    fi

    if (( include_changes )); then
        stage_changes
        check_staged
        commit_args+=(${PATHSPEC[@]+"${PATHSPEC[@]}"})
    else
        # Only the message: do not pick up anything that happens to be staged
        commit_args+=(--only)
    fi

    if ! git commit "${commit_args[@]}"; then
        if (( include_changes )); then
            unstage_paths
        fi
        die "amend failed (hook or message rejected). The previous commit is unchanged."
    fi

    push_branch
}

# ---------------------------------------------------------------------------
# gcp undo
# ---------------------------------------------------------------------------

cmd_undo() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes) ASSUME_YES=1; shift ;;
            *)        die "usage: gcp undo [-y]" ;;
        esac
    done

    require_repo
    require_commits
    require_no_operation
    BRANCH="$(git branch --show-current)"
    [[ -n "$BRANCH" ]] || die "detached HEAD, check out a branch first."
    if is_merge_commit HEAD; then
        die "the last commit is a merge commit. Undo it manually (git revert -m 1 HEAD)."
    fi

    local hash subject
    hash="$(git rev-parse HEAD)"
    subject="$(git log -1 --format=%s)"

    if ! is_pushed HEAD; then
        # Local only: remove the commit, keep its changes staged
        local tags
        tags="$(git tag --points-at HEAD | paste -sd ' ' -)"
        if [[ -n "$tags" ]]; then
            die "tag $tags points at the last commit. Delete it first: git tag -d $tags"
        fi

        require_tty_for_confirm
        echo "Branch:  $BRANCH"
        echo "Undo:    ${hash:0:7} $subject"
        echo "         not pushed yet: the commit is removed, its changes stay staged."
        echo
        confirm "Undo the last commit?"

        if git rev-parse -q --verify HEAD~1 >/dev/null; then
            git reset -q --soft HEAD~1
        else
            # First commit of the repository: keep the index, drop the branch ref
            git update-ref -d HEAD
        fi
        echo "Undone. The changes are staged again, see: gcp status"
        return 0
    fi

    # Already pushed: create and push a revert commit
    require_branch
    require_remote
    git diff --cached --quiet \
        || die "there are staged changes. Commit or unstage them first (git restore --staged .)."

    HEADER="revert: ${GITMOJI[revert]} $subject"
    MESSAGE="${HEADER}"$'\n\n'"This reverts commit $hash."
    WILL_TAG=0

    require_tty_for_confirm
    echo "Branch:  $BRANCH"
    echo "Remote:  $REMOTE"
    echo "Undo:    ${hash:0:7} $subject"
    echo "         already pushed: a new commit reverts its changes."
    echo "Message: $HEADER"
    echo
    confirm "Create and push the revert commit?"

    if ! git revert --no-commit HEAD; then
        git revert --abort 2>/dev/null || true
        die "the revert conflicts with your local changes. Commit or stash them first."
    fi
    if ! git commit -q -m "$MESSAGE"; then
        git revert --abort 2>/dev/null || true
        die "revert commit failed (hook rejected?). Nothing was changed."
    fi
    echo "Reverted ${hash:0:7}."
    push_branch
}

# ---------------------------------------------------------------------------
# gcp status
# ---------------------------------------------------------------------------

cmd_status() {
    [[ $# -eq 0 ]] || die "usage: gcp status"
    require_repo

    local branch upstream remote counts ahead behind
    local -a warnings=()
    branch="$(git branch --show-current)"

    # Branch and remote
    if [[ -z "$branch" ]]; then
        echo "Branch:  ${C_RED}detached HEAD${C_RESET}"
        warnings+=("detached HEAD, check out a branch first")
    elif upstream="$(git rev-parse --abbrev-ref --symbolic-full-name "@{u}" 2>/dev/null)"; then
        counts="$(git rev-list --left-right --count "@{u}...HEAD" 2>/dev/null || echo "0 0")"
        behind="${counts%%[[:space:]]*}"
        ahead="${counts##*[[:space:]]}"
        local sync="up to date"
        if (( ahead || behind )); then
            sync="${ahead} ahead, ${behind} behind"
        fi
        echo "Branch:  ${C_BOLD}${branch}${C_RESET} → ${upstream} (${sync}, as of last fetch)"
    else
        local -a remotes=()
        mapfile -t remotes < <(git remote)
        case ${#remotes[@]} in
            0) remote=""; warnings+=("no remote configured, gcp cannot push") ;;
            1) remote="${remotes[0]}" ;;
            *) remote=""; warnings+=("multiple remotes and no upstream, push once: git push -u <remote> $branch") ;;
        esac
        if git rev-parse -q --verify HEAD >/dev/null; then
            echo "Branch:  ${C_BOLD}${branch}${C_RESET} (no upstream${remote:+, gcp will push to $remote})"
        else
            echo "Branch:  ${C_BOLD}${branch}${C_RESET} (no commits yet${remote:+, gcp will push to $remote})"
        fi
    fi

    # Branch rules
    if [[ -n "$branch" ]] && is_protected_branch "$branch" && [[ "${ALLOW_MAIN:-0}" != "1" ]]; then
        warnings+=("on $branch: gcp needs ALLOW_MAIN=1")
    fi
    if [[ "$branch" == release/* ]]; then
        if [[ "$branch" =~ ^release/([0-9]+)\.([0-9]+)$ ]]; then
            local maj="${BASH_REMATCH[1]}" min="${BASH_REMATCH[2]}" last
            last="$(git tag --list "v${maj}.${min}.*" | sed -E "s/^v${maj}\.${min}\.//" \
                | grep -E '^[0-9]+$' | sort -n | tail -n1 || true)"
            if [[ -n "$last" ]]; then
                echo "Release: next fix creates v${maj}.${min}.$((last + 1)) (local tags); feat and breaking are blocked"
            else
                warnings+=("no base tag v${maj}.${min}.0 yet, a fix would be blocked")
            fi
        else
            warnings+=("release branches must be named release/X.Y")
        fi
    fi

    # Repository rules from .gcprc
    if [[ -f "$REPO_ROOT/.gcprc" ]]; then
        local rules=()
        (( ${#SCOPES[@]} )) && rules+=("scopes: ${SCOPES[*]}")
        [[ "${CFG[require_scope]}" == true ]] && rules+=("scope required")
        [[ "${CFG_SRC[max_header_length]}" != default ]] && rules+=("max ${MAX_HEADER_LENGTH} chars")
        [[ -n "${CFG[base_branch]}" ]] && rules+=("base ${CFG[base_branch]}")
        local joined="" r
        for r in ${rules[@]+"${rules[@]}"}; do
            joined+="${joined:+; }$r"
        done
        echo "Rules:   .gcprc${joined:+ ($joined)}"
    fi

    # Operation in progress
    local op
    op="$(operation_in_progress)"
    if [[ -n "$op" ]]; then
        warnings+=("$op in progress: finish it (git $op --continue) or abort it (git $op --abort)")
    fi

    # Changes
    echo
    if [[ -z "$(git status --porcelain)" ]]; then
        echo "Changes: ${C_GREEN}none, working tree clean${C_RESET}"
    else
        echo "Changes:"
        local color=never
        [[ -t 1 ]] && color=always
        git -c color.status="$color" --no-pager status --short | sed 's/^/  /'

        # Files gcp would block: secret-like names, too large files
        local file size max_bytes=$((MAX_FILE_MIB * 1024 * 1024))
        while IFS= read -r -d '' file; do
            [[ -f "$REPO_ROOT/$file" ]] || continue
            if [[ "$file" =~ $SECRET_PATTERN ]] && [[ ! "$file" =~ $SECRET_ALLOWED ]]; then
                warnings+=("$file looks like a secret, add it to .gitignore")
            fi
            size="$(stat -c %s -- "$REPO_ROOT/$file" 2>/dev/null || stat -f %z -- "$REPO_ROOT/$file" 2>/dev/null || echo 0)"
            if (( size >= max_bytes )); then
                warnings+=("$file is $((size / 1024 / 1024)) MiB, use Git LFS or .gitignore")
            fi
        done < <(git -C "$REPO_ROOT" ls-files -z --modified --others --exclude-standard)
    fi

    # Tools
    if [[ "${SKIP_GITLEAKS:-0}" != "1" ]] && ! command -v gitleaks >/dev/null 2>&1; then
        warnings+=("gitleaks is not installed, gcp will refuse to commit (or use SKIP_GITLEAKS=1)")
    fi

    echo
    if (( ${#warnings[@]} )); then
        echo "Warnings:"
        local w
        for w in "${warnings[@]}"; do
            echo "  ${C_YELLOW}⚠${C_RESET} $w"
        done
    else
        echo "${C_GREEN}✓ Ready for gcp${C_RESET}"
    fi
}

# ---------------------------------------------------------------------------
# gcp history [n] [type]
# ---------------------------------------------------------------------------

cmd_history() {
    local count=10 filter="" arg
    for arg in "$@"; do
        if [[ "$arg" =~ ^[1-9][0-9]*$ ]]; then
            count="$arg"
        elif [[ "$arg" =~ ^(${CC_TYPES}|breaking)$ ]]; then
            filter="$arg"
        else
            die "usage: gcp history [n] [type]  (types: ${CC_TYPES//|/, }, breaking)"
        fi
    done
    require_repo

    if ! git rev-parse -q --verify HEAD >/dev/null; then
        echo "No commits yet."
        return 0
    fi

    local -a grep_args=()
    if [[ "$filter" == "breaking" ]]; then
        grep_args=(-E --grep='^[a-z]+(\([^)]*\))?!: ' --grep='^BREAKING[ -]CHANGE: ')
    elif [[ -n "$filter" ]]; then
        grep_args=(-E --grep="^${filter}(\\([^)]*\\))?!?: ")
    fi

    local hash date subject refs tags out
    out="$(git --no-pager log -n "$count" ${grep_args[@]+"${grep_args[@]}"} \
        --format='%h%x1f%cr%x1f%s%x1f%D%x1e')"
    if [[ -z "$out" ]]; then
        echo "No ${filter:+$filter }commits found."
        return 0
    fi

    # Width of the date column
    local width=0 d
    while IFS= read -r d; do
        (( ${#d} > width )) && width=${#d}
    done < <(printf '%s' "$out" | tr '\036' '\n' | sed '/^$/d' | cut -d $'\037' -f2)

    while IFS=$'\037' read -r -d $'\036' hash date subject refs; do
        hash="${hash#$'\n'}"
        tags=""
        if [[ -n "$refs" ]]; then
            # "HEAD -> main, tag: v1.0.1, origin/main" -> "v1.0.1"
            tags="$(printf '%s' "$refs" | tr ',' '\n' | sed -n 's/^ *tag: //p' | paste -sd ' ' -)"
        fi
        printf '%s%s%s  %s%-*s%s  %s%s\n' \
            "$C_YELLOW" "$hash" "$C_RESET" "$C_DIM" "$width" "$date" "$C_RESET" "$subject" \
            "${tags:+  ${C_GREEN}${tags}${C_RESET}}"
    done <<< "$out"
}

# ---------------------------------------------------------------------------
# Branch workflow helpers
# ---------------------------------------------------------------------------

# Remote for commands that work without a branch context: origin, else the only one
pick_remote() {
    local -a remotes=()
    mapfile -t remotes < <(git remote)
    if [[ " ${remotes[*]} " == *" origin "* ]]; then
        echo origin
    elif (( ${#remotes[@]} == 1 )); then
        echo "${remotes[0]}"
    fi
}

# default_branch [remote]: base_branch from the config, else <remote>/HEAD, else main, else master
default_branch() {
    local remote="${1:-}" ref
    if [[ -n "${CFG[base_branch]}" ]]; then
        echo "${CFG[base_branch]}"
        return
    fi
    if [[ -n "$remote" ]] && ref="$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD" 2>/dev/null)"; then
        echo "${ref#"$remote"/}"
        return
    fi
    for ref in main master; do
        if git rev-parse -q --verify "refs/heads/$ref" >/dev/null \
            || { [[ -n "$remote" ]] && git rev-parse -q --verify "refs/remotes/$remote/$ref" >/dev/null; }; then
            echo "$ref"
            return
        fi
    done
    echo main
}

has_upstream() {
    git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1
}

# Explains a failed pull/rebase and exits
rebase_failed() {
    if [[ -n "$(operation_in_progress)" ]]; then
        echo "Error: rebase stopped because of a conflict." >&2
        echo "Your commits are safe. Resolve the conflicts, then run:" >&2
        echo "  git add <files> && git rebase --continue" >&2
        echo "Or go back to where you were with:" >&2
        echo "  git rebase --abort" >&2
    else
        echo "Error: could not update from $REMOTE (network, access or missing branch?)." >&2
    fi
    exit 1
}

# ---------------------------------------------------------------------------
# gcp new <type> <name>
# ---------------------------------------------------------------------------

cmd_new() {
    [[ $# -ge 2 ]] || die "usage: gcp new <type> <name>  (e.g. gcp new feat login form)"
    local type="$1" name branch remote base start
    shift
    [[ "$type" =~ ^(${CC_TYPES})$ ]] || die "unknown type '$type'. Types: ${CC_TYPES//|/, }"

    # "Login Form" -> login-form
    name="$(printf '%s' "$*" | tr '[:upper:]' '[:lower:]' \
        | sed -E 's/[^a-z0-9._-]+/-/g; s/-+/-/g; s/^[-.]+//; s/[-.]+$//')"
    [[ -n "$name" ]] || die "branch name is empty (use letters, digits, '-', '_' or '.')."
    branch="$type/$name"
    git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "invalid branch name: $branch"

    require_repo
    require_commits
    require_no_operation
    if git rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
        die "branch $branch already exists. Switch to it with: git switch $branch"
    fi

    remote="$(pick_remote)"
    base="$(default_branch "$remote")"
    start="$base"
    if [[ -n "$remote" ]]; then
        if git fetch --quiet "$remote" "$base" 2>/dev/null; then
            start="$remote/$base"
        else
            echo "Warning: could not fetch $remote/$base, starting from the local $base." >&2
        fi
    fi
    git rev-parse -q --verify "$start^{commit}" >/dev/null || die "base branch $start not found."

    # --no-track: the new branch must not push to or pull from main
    git switch --quiet --no-track -c "$branch" "$start" \
        || die "could not create $branch. Commit or stash changes that conflict with $start first."

    echo "Created ${C_BOLD}${branch}${C_RESET} from ${start} and switched to it."
    echo "Next: make your changes, then: gcp \"$type: ...\" and gcp pr"
}

# ---------------------------------------------------------------------------
# gcp sync [-y]
# ---------------------------------------------------------------------------

cmd_sync() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes) ASSUME_YES=1; shift ;;
            *)        die "usage: gcp sync [-y]" ;;
        esac
    done
    require_repo
    require_commits
    require_no_operation
    BRANCH="$(git branch --show-current)"
    [[ -n "$BRANCH" ]] || die "detached HEAD, check out a branch first."
    require_remote

    local base pushed_only behind
    base="$(default_branch "$REMOTE")"

    if [[ "$BRANCH" == "$base" ]]; then
        git pull --quiet --rebase --autostash "$REMOTE" "$base" || rebase_failed
        echo "${C_GREEN}✓${C_RESET} $base is up to date with $REMOTE."
        return 0
    fi

    git fetch --quiet "$REMOTE" "$base" || die "could not fetch $REMOTE/$base."
    git rev-parse -q --verify "$REMOTE/$base" >/dev/null || die "$REMOTE/$base not found."

    # First take over commits pushed to this branch from elsewhere
    if has_upstream; then
        git pull --quiet --rebase --autostash || rebase_failed
    fi

    behind="$(git rev-list --count "HEAD..$REMOTE/$base")"
    if (( behind == 0 )); then
        echo "${C_GREEN}✓${C_RESET} $BRANCH already has all commits from $base."
        return 0
    fi

    # Pushed commits that the rebase will rewrite -> force push needed
    pushed_only=0
    if has_upstream; then
        pushed_only="$(git rev-list --count "$REMOTE/$base..@{u}")"
    fi

    echo "Rebasing ${C_BOLD}${BRANCH}${C_RESET} onto $REMOTE/$base ($behind new commit(s) on $base)."
    if (( pushed_only )); then
        echo "$pushed_only commit(s) of $BRANCH are already pushed. They get new hashes,"
        echo "so the branch is pushed with --force-with-lease afterwards."
        require_tty_for_confirm
        confirm "Continue?"
    fi

    git rebase --quiet --autostash "$REMOTE/$base" || rebase_failed

    if has_upstream && ! git merge-base --is-ancestor "@{u}" HEAD; then
        git push --quiet --force-with-lease \
            || die "rebase done, but the push failed. Retry with: git push --force-with-lease"
        echo "Pushed $BRANCH (--force-with-lease)."
    fi
    echo "${C_GREEN}✓${C_RESET} $BRANCH is up to date with $base."
}

# ---------------------------------------------------------------------------
# gcp pr [-y] [--draft | --merge]
# ---------------------------------------------------------------------------

cmd_pr() {
    local merge=0 draft=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes)   ASSUME_YES=1; shift ;;
            -d|--draft) draft=1; shift ;;
            --merge)    merge=1; shift ;;
            *)          die "usage: gcp pr [-y] [--draft | --merge]" ;;
        esac
    done
    (( draft && merge )) && die "--draft and --merge cannot be combined."

    require_repo
    require_commits
    require_no_operation
    command -v gh >/dev/null 2>&1 || die "gcp pr needs the GitHub CLI (gh): https://cli.github.com"
    BRANCH="$(git branch --show-current)"
    [[ -n "$BRANCH" ]] || die "detached HEAD, check out a branch first."
    require_remote

    local base title body existing url line
    base="$(default_branch "$REMOTE")"
    if [[ "$BRANCH" == "$base" || "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
        die "you are on $BRANCH. Create a branch first: gcp new <type> <name>"
    fi

    git fetch --quiet "$REMOTE" "$base" || die "could not fetch $REMOTE/$base."
    local -a commits=()
    mapfile -t commits < <(git log --reverse --no-merges --format='%h %s' "$REMOTE/$base..HEAD")
    (( ${#commits[@]} )) || die "$BRANCH has no commits that are not on $base. Commit first: gcp \"<type>: ...\""

    # Title: the only commit, otherwise built from the branch name (feat/login-form -> feat: ✨ login form)
    if (( ${#commits[@]} == 1 )); then
        title="${commits[0]#* }"
    elif [[ "$BRANCH" =~ ^(${CC_TYPES})/(.+)$ ]]; then
        local words="${BASH_REMATCH[2]//[-_\/]/ }"
        parse_message "${BASH_REMATCH[1]}: $words" 0
        title="$HEADER"
    else
        title="${commits[0]#* }"
    fi

    body="## Commits"$'\n'
    for line in "${commits[@]}"; do
        body+=$'\n'"- ${line#* } (${line%% *})"
    done

    existing="$(gh pr view "$BRANCH" --json url,state -q 'select(.state == "OPEN") | .url' 2>/dev/null || true)"

    echo "Branch:  ${C_BOLD}${BRANCH}${C_RESET} → ${base}"
    if [[ -n "$existing" ]]; then
        echo "PR:      already open: $existing (only pushing)"
    else
        echo "Title:   ${C_BOLD}${title}${C_RESET}"
        (( draft )) && echo "Draft:   yes"
    fi
    echo "Commits:"
    for line in "${commits[@]}"; do
        echo "  ${C_DIM}${line%% *}${C_RESET} ${line#* }"
    done
    (( merge )) && echo "Then:    squash merge, delete the branch, switch to $base"
    echo

    require_tty_for_confirm
    if (( merge )); then
        confirm "Push, create the pull request and merge it?"
    else
        confirm "Push and ${existing:+update}${existing:-create} the pull request?"
    fi

    push_branch

    if [[ -n "$existing" ]]; then
        url="$existing"
    else
        local -a create=(gh pr create --base "$base" --head "$BRANCH" --title "$title" --body "$body")
        (( draft )) && create+=(--draft)
        url="$("${create[@]}")" || die "pushed, but creating the pull request failed. Retry with: gcp pr"
        url="$(tail -n1 <<< "$url")"
    fi
    echo "Pull request: $url"

    if (( merge )); then
        # The PR title (maybe edited on GitHub) becomes the commit on the base branch;
        # without --subject GitHub uses the commit message for one-commit PRs
        local subject
        subject="$(gh pr view "$BRANCH" --json title,number -q '"\(.title) (#\(.number))"')" \
            || die "could not read the pull request. It stays open: $url"
        gh pr merge "$BRANCH" --squash --delete-branch --subject "$subject" \
            || die "merging failed (checks, reviews or conflicts?). The PR stays open: $url"
        # gh usually switches back already; make sure and update the base branch
        if [[ "$(git branch --show-current)" != "$base" ]]; then
            git switch --quiet "$base" || die "merged, but could not switch to $base."
        fi
        git pull --quiet --ff-only "$REMOTE" "$base" \
            || echo "Warning: merged, but could not update the local $base. Run: gcp sync" >&2
        git branch -D "$BRANCH" >/dev/null 2>&1 || true
        echo "${C_GREEN}✓${C_RESET} Merged and back on $base."
    fi
}

# ---------------------------------------------------------------------------
# Changelog: gcp changelog, used by gcp release
# ---------------------------------------------------------------------------

# Last release tag vX.Y.Z reachable from HEAD, or nothing
last_release_tag() {
    git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' HEAD 2>/dev/null || true
}

# build_changelog <rev-range> <all: 0|1>
# Sets CHANGELOG (markdown sections), CL_COMMITS, CL_BREAKING, CL_FEAT.
build_changelog() {
    local range="$1" all="$2"
    local -a breaking=() feat=() fix=() perf=() other=()
    local hash subject body type scope bang desc first entry
    local breaking_re=$'(^|\n)BREAKING[ -]CHANGE: '
    CL_COMMITS=0

    while IFS=$'\x1f' read -r -d $'\x1e' hash subject body; do
        hash="${hash#$'\n'}"
        (( CL_COMMITS++ )) || true
        if [[ ! "$subject" =~ ^(${CC_TYPES})(\(([a-z0-9._/-]+)\))?(!)?:\ (.+)$ ]]; then
            (( all )) && other+=("- $subject ($hash)")
            continue
        fi
        type="${BASH_REMATCH[1]}" scope="${BASH_REMATCH[3]}" bang="${BASH_REMATCH[4]}" desc="${BASH_REMATCH[5]}"
        first="${desc%% *}"
        if is_emoji "$first" && [[ "$desc" == *" "* ]]; then
            desc="${desc#* }"
        fi
        entry="- ${scope:+**$scope:** }$desc ($hash)"

        if [[ -n "$bang" || "$body" =~ $breaking_re ]]; then
            breaking+=("$entry")
        else
            case "$type" in
                feat) feat+=("$entry") ;;
                fix)  fix+=("$entry") ;;
                perf) perf+=("$entry") ;;
                *)    (( all )) && other+=("$entry") ;;
            esac
        fi
    done < <(git log --no-merges --format='%h%x1f%s%x1f%b%x1e' "$range")

    CL_BREAKING=${#breaking[@]}
    CL_FEAT=${#feat[@]}
    CHANGELOG=""
    _cl_section "${GITMOJI_BREAKING} Breaking Changes" ${breaking[@]+"${breaking[@]}"}
    _cl_section "${GITMOJI[feat]} Features" ${feat[@]+"${feat[@]}"}
    _cl_section "${GITMOJI[fix]} Bug Fixes" ${fix[@]+"${fix[@]}"}
    _cl_section "${GITMOJI[perf]} Performance" ${perf[@]+"${perf[@]}"}
    _cl_section "${GITMOJI[chore]} Other Changes" ${other[@]+"${other[@]}"}
    CHANGELOG="${CHANGELOG%$'\n'}"
}

_cl_section() {
    local title="$1"
    shift
    (( $# )) || return 0
    CHANGELOG+="### $title"$'\n\n'
    printf -v title '%s\n' "$@"
    CHANGELOG+="$title"$'\n'
}

cmd_changelog() {
    local all=0 from=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a|--all) all=1; shift ;;
            -*)       die "usage: gcp changelog [--all] [since]" ;;
            *)        [[ -z "$from" ]] || die "usage: gcp changelog [--all] [since]"
                      from="$1"; shift ;;
        esac
    done
    require_repo
    require_commits

    local range heading
    if [[ -z "$from" ]]; then
        from="$(last_release_tag)"
    else
        git rev-parse -q --verify "$from^{commit}" >/dev/null || die "unknown tag or commit: $from"
    fi
    if [[ -n "$from" ]]; then
        range="$from..HEAD"
        heading="## Unreleased (since $from)"
    else
        range="HEAD"
        heading="## Unreleased"
    fi

    build_changelog "$range" "$all"
    if [[ -z "$CHANGELOG" ]]; then
        if (( CL_COMMITS )); then
            echo "No features, fixes or breaking changes since ${from:-the first commit} (${CL_COMMITS} other commit(s), see --all)."
        else
            echo "No commits since ${from:-the first commit}."
        fi
        return 0
    fi
    printf '%s\n\n%s\n' "$heading" "$CHANGELOG"
}

# ---------------------------------------------------------------------------
# gcp release [-y] [-n] [major|minor|patch]
# ---------------------------------------------------------------------------

cmd_release() {
    local bump="" dry=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes)               ASSUME_YES=1; shift ;;
            -n|--dry-run)           dry=1; shift ;;
            major|minor|patch)      bump="$1"; shift ;;
            *)                      die "usage: gcp release [-y] [-n|--dry-run] [major|minor|patch]" ;;
        esac
    done
    require_repo
    require_commits
    require_no_operation
    BRANCH="$(git branch --show-current)"
    [[ -n "$BRANCH" ]] || die "detached HEAD, check out a branch first."
    require_remote

    local base last major=0 minor=0 patch=0 range reason new
    base="$(default_branch "$REMOTE")"
    if [[ "$BRANCH" != "$base" ]]; then
        if [[ "$BRANCH" == release/* ]]; then
            die "on release branches, gcp tags every fix automatically. gcp release runs on $base."
        fi
        die "releases are made from $base (you are on $BRANCH). Run: git switch $base"
    fi
    [[ -z "$(git status --porcelain --untracked-files=no)" ]] \
        || die "there are uncommitted changes. Commit or stash them first."

    git fetch --quiet --tags "$REMOTE" || die "could not fetch from $REMOTE."
    has_upstream || die "$BRANCH has no upstream. Push it first."
    local counts behind ahead
    counts="$(git rev-list --left-right --count "@{u}...HEAD")"
    behind="${counts%%[[:space:]]*}"
    ahead="${counts##*[[:space:]]}"
    (( behind == 0 )) || die "$BRANCH is $behind commit(s) behind $REMOTE. Run: gcp sync"
    (( ahead == 0 ))  || die "$BRANCH has $ahead unpushed commit(s). Push them first, the release must be on $REMOTE."

    last="$(last_release_tag)"
    if [[ -n "$last" ]]; then
        [[ "$last" =~ ^v([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || die "last tag $last is not vX.Y.Z."
        major="${BASH_REMATCH[1]}" minor="${BASH_REMATCH[2]}" patch="${BASH_REMATCH[3]}"
        range="$last..HEAD"
    else
        range="HEAD"
    fi

    build_changelog "$range" 0
    (( CL_COMMITS )) || die "nothing to release, no commits since $last."

    if [[ -z "$bump" ]]; then
        if (( CL_BREAKING )); then
            bump='major'; reason="breaking changes"
            if (( major == 0 )); then
                bump='minor'; reason="breaking changes, but still 0.x"
            fi
        elif (( CL_FEAT )); then
            bump='minor'; reason="new features"
        else
            bump='patch'; reason="fixes and other changes"
        fi
    else
        reason="chosen by hand"
    fi
    if [[ -z "$last" ]]; then
        new="v0.1.0"
        [[ "$bump" == major ]] && new="v1.0.0"
        reason="first release"
    else
        case "$bump" in
            major) new="v$((major + 1)).0.0" ;;
            minor) new="v${major}.$((minor + 1)).0" ;;
            patch) new="v${major}.${minor}.$((patch + 1))" ;;
        esac
    fi
    if git rev-parse -q --verify "refs/tags/$new" >/dev/null; then
        die "tag $new already exists."
    fi

    local notes="$CHANGELOG"
    [[ -n "$notes" ]] || notes="Maintenance release ($CL_COMMITS commit(s), no features or fixes)."

    echo "Release: ${last:-(none)} → ${C_BOLD}${new}${C_RESET} ($bump: $reason)"
    echo
    echo "$notes"
    echo

    if (( dry )); then
        echo "Dry run, nothing was tagged."
        return 0
    fi

    local gh_release=0
    if command -v gh >/dev/null 2>&1 && [[ "$(git remote get-url "$REMOTE")" == *github.com* ]]; then
        gh_release=1
    fi

    require_tty_for_confirm
    if (( gh_release )); then
        confirm "Tag $new, push it and create the GitHub release?"
    else
        confirm "Tag $new and push it?"
    fi

    git tag -a "$new" -m "$new"
    if ! git push --quiet "$REMOTE" "refs/tags/$new"; then
        echo "Error: pushing tag $new failed. Retry with: git push $REMOTE refs/tags/$new" >&2
        exit 1
    fi
    echo "Pushed tag $new."

    if (( gh_release )); then
        gh release create "$new" --verify-tag --title "$new" --notes "$notes" \
            || die "tag pushed, but creating the GitHub release failed. Retry with: gh release create $new --generate-notes"
    else
        echo "No GitHub release created (needs gh and a GitHub remote)."
    fi
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
    case "$1" in
        -y|--yes)          ASSUME_YES=1; shift ;;
        -i|--interactive)  INTERACTIVE=1; shift ;;
        -iy|-yi)           ASSUME_YES=1; INTERACTIVE=1; shift ;;
        -h|--help)         show_help; exit 0 ;;
        -v|-V|--version)   echo "gcp $GCP_VERSION"; exit 0 ;;
        --)                shift; break ;;
        -*)                die "unknown option: $1
$USAGE" ;;
        *)                 break ;;
    esac
done

[[ $# -ge 1 ]] || die "$USAGE"

case "$1" in
    status)  shift; cmd_status "$@" ;;
    history) shift; cmd_history "$@" ;;
    undo)    shift; cmd_undo "$@" ;;
    amend)   shift; cmd_amend "$@" ;;
    new)     shift; cmd_new "$@" ;;
    sync)    shift; cmd_sync "$@" ;;
    pr)      shift; cmd_pr "$@" ;;
    changelog) shift; cmd_changelog "$@" ;;
    release) shift; cmd_release "$@" ;;
    config)  shift; cmd_config "$@" ;;
    *)       cmd_commit "$@" ;;
esac
