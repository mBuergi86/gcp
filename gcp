#!/usr/bin/env bash
# gcp - stage, commit and push in one step, with safety checks.
#
# Usage:
#   gcp [-y] [-i] "<type>[(scope)][!]: [gitmoji] <description>" [--] [path...]
#   gcp amend [-y] [-i] [-m "<message>"] [--] [path...]
#   gcp undo [-y]
#   gcp status
#   gcp history [n] [type]
#   gcp new <type> <name>
#   gcp sync [-y]
#   gcp pr [-y] [--draft | --merge]
#   gcp changelog [--all] [since]
#   gcp release [-y] [-n] [major|minor|patch]
#   gcp config [name]
#
# Settings: ~/.config/gcp/config, then .gcprc in the repository, then GCP_*
# environment variables (scopes, require_scope, max_header_length, base_branch).
#
#   -y, --yes          skip the confirmation prompt (also: GCP_YES=1)
#   -i, --interactive  pick the files to commit from a list (fzf if installed)
#   -v, -V, --version  print the version
#   path...            commit only these files/directories (default: all changes)
#
# Commit messages must follow Conventional Commits 1.0.0:
#   https://www.conventionalcommits.org/en/v1.0.0/
# A gitmoji (https://gitmoji.dev) is added after the colon based on the type.
# If you write your own gitmoji (unicode or :shortcode:), it is kept.
# Breaking changes always get 💥.
#
# Release tagging (only on release/X.Y branches):
#   fix                 -> next patch tag vX.Y.Z, created and pushed automatically
#   feat, or breaking   -> rejected (needs a new release branch)
#   all other types     -> committed and pushed, no tag
#
# Requires: git >= 2.22, gitleaks >= 8.19, bash >= 4
# Env overrides:
#   ALLOW_MAIN=1      allow committing directly to main/master
#   SKIP_GITLEAKS=1   skip the content secret scan (not recommended)
#   GCP_NO_FZF=1      use the numbered list for -i even if fzf is installed
set -euo pipefail

GCP_VERSION="1.2.0"
MAX_FILE_MIB=100
MAX_HEADER_LENGTH=72
CC_TYPES='feat|fix|build|chore|ci|docs|style|refactor|perf|test|revert'
CC_REGEX="^(${CC_TYPES})(\([a-z0-9._/-]+\))?(!)?: ([^[:space:]].*)$"
# File names that look like secrets (files ending in .example/.sample/.template/.dist are allowed)
SECRET_PATTERN='(^|/)(\.env(\.[^/]+)?|id_rsa|id_ed25519|[^/]+\.pem|[^/]+\.key|[^/]+\.p12|[^/]+\.pfx|credentials(\.json)?)$'
SECRET_ALLOWED='\.(example|sample|template|dist)$'

# Type -> gitmoji (https://github.com/carloscuesta/gitmoji)
declare -A GITMOJI=(
    [feat]="✨"
    [fix]="🐛"
    [docs]="📝"
    [style]="🎨"
    [refactor]="♻️"
    [perf]="⚡️"
    [test]="✅"
    [build]="📦️"
    [ci]="👷"
    [chore]="🔧"
    [revert]="⏪️"
)
GITMOJI_BREAKING="💥"

if [[ -t 1 ]]; then
    C_RESET=$'\e[0m'; C_DIM=$'\e[2m'; C_BOLD=$'\e[1m'
    C_YELLOW=$'\e[33m'; C_GREEN=$'\e[32m'; C_RED=$'\e[31m'
else
    C_RESET=""; C_DIM=""; C_BOLD=""; C_YELLOW=""; C_GREEN=""; C_RED=""
fi

# Global state, set by the option parser and the helpers below
ASSUME_YES="${GCP_YES:-0}"
INTERACTIVE=0
PATHS=()      # paths to commit; empty means "all changes"
PATHSPEC=()   # "-- path..." for git, or nothing. Expand with ${PATHSPEC[@]+"${PATHSPEC[@]}"}
GIT_DIR=""
REPO_ROOT=""
BRANCH=""
REMOTE=""

# ---------------------------------------------------------------------------
# Configuration: ~/.config/gcp/config, then .gcprc in the repo, then GCP_* env
# ---------------------------------------------------------------------------

CONFIG_KEYS=(scopes require_scope max_header_length base_branch)
declare -A CFG=(
    [scopes]=""
    [require_scope]="false"
    [max_header_length]="$MAX_HEADER_LENGTH"
    [base_branch]=""
)
declare -A CFG_SRC=(
    [scopes]="default"
    [require_scope]="default"
    [max_header_length]="default"
    [base_branch]="default"
)
SCOPES=()           # allowed scopes, empty means any
CONFIG_LOADED=0

global_config_file() {
    echo "${XDG_CONFIG_HOME:-$HOME/.config}/gcp/config"
}

# config_set <key> <value> <source>: validates and stores one setting
config_set() {
    local key="$1" value="$2" src="$3" item
    case "$key" in
        scopes)
            # "api, ui , docs" -> "api,ui,docs"
            value="$(printf '%s' "$value" | tr -d '[:space:]' | sed -E 's/,+/,/g; s/^,//; s/,$//')"
            local -a items=()
            IFS=',' read -r -a items <<< "$value"
            for item in ${items[@]+"${items[@]}"}; do
                [[ "$item" =~ ^[a-z0-9._/-]+$ ]] \
                    || die "$src: invalid scope '$item' (use lowercase letters, digits, . _ / -)."
            done
            ;;
        require_scope)
            case "${value,,}" in
                true|yes|on|1)   value=true ;;
                false|no|off|0)  value=false ;;
                *) die "$src: require_scope must be true or false (got: $value)." ;;
            esac
            ;;
        max_header_length)
            if [[ ! "$value" =~ ^[0-9]+$ ]] || (( value < 20 || value > 200 )); then
                die "$src: max_header_length must be a number from 20 to 200 (got: $value)."
            fi
            ;;
        base_branch)
            git check-ref-format --branch "$value" >/dev/null 2>&1 \
                || die "$src: base_branch '$value' is not a valid branch name."
            ;;
        skip_gitleaks|allow_main|yes|gcp_yes)
            die "$src: '$key' cannot be set in a config file. Safety checks can only be turned off per call (SKIP_GITLEAKS=1, ALLOW_MAIN=1)."
            ;;
        *)
            die "$src: unknown setting '$key'. Known: ${CONFIG_KEYS[*]}"
            ;;
    esac
    CFG[$key]="$value"
    CFG_SRC[$key]="$src"
}

# read_config_file <file> <label>: "key = value" lines; never executed
read_config_file() {
    local file="$1" label="$2" line key value n=0
    [[ -f "$file" ]] || return 0
    [[ -r "$file" ]] || die "$label is not readable."
    while IFS= read -r line || [[ -n "$line" ]]; do
        (( n++ )) || true
        line="${line%$'\r'}"
        # strip leading/trailing whitespace; skip blank lines and comments
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" == \#* || "$line" == \;* ]] && continue
        [[ "$line" =~ ^([A-Za-z_]+)[[:space:]]*=[[:space:]]*(.*)$ ]] \
            || die "$label line $n: expected 'name = value', got: $line"
        key="${BASH_REMATCH[1],,}"
        value="${BASH_REMATCH[2]}"
        # optional quotes around the value
        if [[ "$value" =~ ^\"(.*)\"$ || "$value" =~ ^\'(.*)\'$ ]]; then
            value="${BASH_REMATCH[1]}"
        fi
        config_set "$key" "$value" "$label:$n"
    done < "$file"
}

# Loads all config sources once; needs REPO_ROOT for .gcprc
load_config() {
    (( CONFIG_LOADED )) && return 0
    CONFIG_LOADED=1
    local gfile key env_name
    gfile="$(global_config_file)"
    read_config_file "$gfile" "${gfile/#"$HOME"/\~}"
    [[ -n "$REPO_ROOT" ]] && read_config_file "$REPO_ROOT/.gcprc" ".gcprc"
    for key in "${CONFIG_KEYS[@]}"; do
        env_name="GCP_${key^^}"
        if [[ -n "${!env_name:-}" ]]; then
            config_set "$key" "${!env_name}" "$env_name"
        fi
    done

    MAX_HEADER_LENGTH="${CFG[max_header_length]}"
    SCOPES=()
    [[ -n "${CFG[scopes]}" ]] && IFS=',' read -r -a SCOPES <<< "${CFG[scopes]}"
    return 0
}

# check_scope <scope or empty> <type>: enforces scopes / require_scope
check_scope() {
    local scope="$1" type="$2" s
    if [[ -z "$scope" ]]; then
        # gcp undo writes "revert: ..." without scope; never block that
        if [[ "${CFG[require_scope]}" == true && "$type" != revert ]]; then
            {
                echo "Error: a scope is required in this repository (require_scope in ${CFG_SRC[require_scope]})."
                echo "  Example:  $type(${SCOPES[0]:-api}): ..."
                (( ${#SCOPES[@]} )) && echo "  Scopes:   ${SCOPES[*]}"
            } >&2
            exit 1
        fi
        return 0
    fi
    (( ${#SCOPES[@]} )) || return 0
    for s in "${SCOPES[@]}"; do
        [[ "$s" == "$scope" ]] && return 0
    done
    {
        echo "Error: scope '$scope' is not allowed here (scopes in ${CFG_SRC[scopes]})."
        echo "  Scopes:   ${SCOPES[*]}"
        # Hint for a likely typo: same first letter or same letters
        local hint=""
        for s in "${SCOPES[@]}"; do
            if [[ "$(sorted_letters "$s")" == "$(sorted_letters "$scope")" ]]; then
                hint="$s"; break
            fi
        done
        [[ -n "$hint" ]] && echo "  Did you mean '$hint'?"
    } >&2
    exit 1
}

sorted_letters() {
    printf '%s' "$1" | fold -w1 | sort | tr -d '\n'
}

# ---------------------------------------------------------------------------
# gcp config [key]
# ---------------------------------------------------------------------------

cmd_config() {
    [[ $# -le 1 ]] || die "usage: gcp config [name]"
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        require_repo
    else
        load_config
    fi

    if [[ $# -eq 1 ]]; then
        local key="${1,,}"
        [[ " ${CONFIG_KEYS[*]} " == *" $key "* ]] || die "unknown setting '$1'. Known: ${CONFIG_KEYS[*]}"
        echo "${CFG[$key]}"
        return 0
    fi

    local gfile key value
    gfile="$(global_config_file)"
    echo "Files (later ones win, then GCP_* environment variables):"
    if [[ -f "$gfile" ]]; then
        echo "  ${gfile/#"$HOME"/\~}"
    else
        echo "  ${C_DIM}${gfile/#"$HOME"/\~} (not found)${C_RESET}"
    fi
    if [[ -n "$REPO_ROOT" && -f "$REPO_ROOT/.gcprc" ]]; then
        echo "  .gcprc"
    else
        echo "  ${C_DIM}.gcprc (not found)${C_RESET}"
    fi
    echo
    echo "Settings:"
    for key in "${CONFIG_KEYS[@]}"; do
        value="${CFG[$key]}"
        case "$key" in
            scopes)      [[ -n "$value" ]] || value="(any)" ;;
            base_branch)
                if [[ -z "$value" ]]; then
                    if [[ -n "$REPO_ROOT" ]]; then
                        value="(auto: $(default_branch "$(pick_remote)"))"
                    else
                        value="(auto)"
                    fi
                fi
                ;;
        esac
        printf '  %-18s %-30s %s\n' "$key" "${value//,/, }" "${C_DIM}${CFG_SRC[$key]}${C_RESET}"
    done
}

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

die() {
    echo "Error: $*" >&2
    exit 1
}

show_help() {
    cat <<'EOF'
gcp - stage, commit and push in one step, with safety checks

Usage:
  gcp [options] "<type>[(scope)][!]: <description>" [--] [path...]
  gcp amend [options] [-m "<message>"] [--] [path...]
                              add changes to the last commit (only if not pushed)
  gcp undo [-y]               undo the last commit (reset if local, revert if pushed)
  gcp status                  show branch, changes and what gcp would block
  gcp history [n] [type]      show the last n commits (default 10), optional type filter

Branch workflow:
  gcp new <type> <name>       new branch <type>/<name> from the latest main
  gcp sync [-y]               rebase the branch onto the latest main
  gcp pr [--draft|--merge]    push and open a pull request (needs gh);
                              --merge also squash merges and returns to main
  gcp changelog [--all] [since]
                              features, fixes and breaking changes since the last tag
  gcp release [-n] [major|minor|patch]
                              tag the next version on main (from the commits)
                              and create the GitHub release; -n: dry run

  Without paths, all changes are committed. With paths, only those.
  The message must be quoted and comes before the paths.

Options:
  -i, --interactive   pick the files from a list (fzf with diff preview if installed)
  -y, --yes           skip the confirmation prompt
  -h, --help          show this help
  -v, -V, --version   show the version

Environment:
  ALLOW_MAIN=1        allow committing directly to main/master
  SKIP_GITLEAKS=1     skip the secret scan (not recommended)
  GCP_YES=1           same as -y
  GCP_NO_FZF=1        use the numbered list for -i even if fzf is installed
  GCP_SCOPES, GCP_REQUIRE_SCOPE, GCP_MAX_HEADER_LENGTH, GCP_BASE_BRANCH
                      override the settings from .gcprc

Settings:
  gcp config [name]           show the settings and where they come from
  .gcprc in the repository (or ~/.config/gcp/config), "name = value" lines:
