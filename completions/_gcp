#compdef gcp
# zsh completion for gcp (https://github.com/mBuergi86/gcp)

# Files with changes (modified, deleted, untracked, staged), relative to $PWD.
_gcp_changed_files() {
    local -a files
    files=(
        ${(f)"$(git ls-files --modified --deleted --others --exclude-standard 2>/dev/null)"}
        ${(f)"$(git diff --cached --name-only --relative 2>/dev/null)"}
    )
    files=(${(u)files})
    (( ${#files} )) && _describe -t files 'changed file' files && return 0
    _files
}

# Scopes from the gcp config (.gcprc), after "type(" was typed
_gcp_scopes() {
    local -a scopes
    scopes=(${(s:,:)"$(command gcp config scopes 2>/dev/null)"})
    (( ${#scopes} )) || return 1
    compset -P '*\('
    _wanted scopes expl 'scope (.gcprc)' compadd -S '): ' -- $scopes
}

# Commit type, or the scope once "type(" is typed
_gcp_message() {
    if [[ $PREFIX =~ '^[a-z]+\(' ]]; then
        _gcp_scopes
    else
        _gcp_types
    fi
}

_gcp_types() {
    local -a types
    types=(
        'feat:✨ new feature'
        'fix:🐛 bug fix'
        'docs:📝 documentation'
        'style:🎨 formatting'
        'refactor:♻️ restructure code'
        'perf:⚡️ performance'
        'test:✅ tests'
        'build:📦️ build system, dependencies'
        'ci:👷 CI configuration'
        'chore:🔧 maintenance'
        'revert:⏪️ revert a commit'
    )
    # The message must be one argument: open a quote if the user has not.
    local -a qopt
    [[ -z $compstate[quote] ]] && qopt=(-P '"')
    _describe -t types 'commit type' types $qopt -S ': '
}

_gcp() {
    local -a subcmds opts
    subcmds=(
        'status:show branch, changes and what gcp would block'
        'history:show the last commits'
        'undo:undo the last commit'
        'amend:add changes to the last commit'
        'new:create a branch <type>/<name> from the latest main'
        'sync:rebase the branch onto the latest main'
        'pr:push and open a pull request'
        'changelog:features, fixes and breaking changes since the last tag'
        'release:tag the next version and create the GitHub release'
        'config:show the settings from .gcprc and ~/.config/gcp/config'
    )
    opts=(
        '(-i --interactive)'{-i,--interactive}'[pick the files from a list]'
        '(-y --yes)'{-y,--yes}'[skip the confirmation prompt]'
    )

    # Skip leading options to find the subcommand / message position.
    local i=2
    while (( i < CURRENT )) && [[ ${words[i]} == -* && ${words[i]} != -- ]]; do
        (( i++ ))
    done
    [[ ${words[i]} == -- ]] && (( i++ ))

    if (( CURRENT == i )); then
        if [[ $PREFIX == -* ]]; then
            _arguments -s $opts \
                '(- *)'{-h,--help}'[show help]' \
                '(- *)'{-v,-V,--version}'[show version]'
        else
            if [[ $PREFIX =~ '^[a-z]+\(' ]]; then
                _gcp_scopes
            else
                _describe -t commands 'gcp command' subcmds
                _gcp_types
            fi
        fi
        return
    fi

    # Let _arguments see the subcommand as the command name
    words=(${words[i,-1]})
    (( CURRENT -= i - 1 ))

    case ${words[1]} in
        status)
            ;;
        history)
            local -a htypes
            htypes=(feat fix docs style refactor perf test build ci chore revert breaking)
            _alternative 'count:number of commits:(5 10 20 50)' "types:type:($htypes)"
            ;;
        undo|sync)
            _arguments '(-y --yes)'{-y,--yes}'[skip the confirmation prompt]'
            ;;
        config)
            (( CURRENT == 2 )) && _values 'setting' scopes require_scope max_header_length base_branch
            ;;
        new)
            if (( CURRENT == 2 )); then
                local -a btypes
                btypes=(feat fix docs style refactor perf test build ci chore revert)
                _describe -t types 'branch type' btypes
            else
                _message 'branch name'
            fi
            ;;
        pr)
            _arguments \
                '(-y --yes)'{-y,--yes}'[skip the confirmation prompt]' \
                '(-d --draft --merge)'{-d,--draft}'[create a draft pull request]' \
                '(-d --draft)--merge[squash merge right away and return to main]'
            ;;
        changelog)
            local -a tags
            tags=(${(f)"$(git tag --list 'v*' --sort=-v:refname 2>/dev/null)"})
            _arguments \
                '(-a --all)'{-a,--all}'[include all commit types]' \
                "1:since:(${tags[*]})"
            ;;
        release)
            _arguments \
                '(-y --yes)'{-y,--yes}'[skip the confirmation prompt]' \
                '(-n --dry-run)'{-n,--dry-run}'[show the next version, tag nothing]' \
                '1:bump:(major minor patch)'
            ;;
        amend)
            if [[ ${words[CURRENT-1]} == -m ]]; then
                _gcp_message
            elif [[ $PREFIX == -* ]]; then
                _arguments -s $opts '-m[new commit message]'
            else
                _gcp_changed_files
            fi
            ;;
        *)
            # After the message: paths.
            _gcp_changed_files
            ;;
    esac
}

_gcp "$@"
